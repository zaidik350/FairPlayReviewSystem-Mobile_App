EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_API_BASE_URL=https://narcissistically-inventoriable-wynell.ngrok-free.dev/api
# Same machine as the API, reachable from a physical phone on Wi‑Fi (use ipconfig / ifconfig). Used first for video uploads so they bypass ngrok.
EXPO_PUBLIC_LAN_API_BASE_URL=http://192.168.1.100:8000/api
# Optional; default 180000 ms. Raise if ML inference is slow.
EXPO_PUBLIC_UPLOAD_TIMEOUT_MS=180000
